# Copy to backend/functions/.env.local for the emulator (never commit real values).
# Params (plain config)
SUPABASE_URL=https://uicqczgpiqkczwyssdft.supabase.co
API_VERSION=1.0.0
# WhatsApp via Twilio (INT-002). Provider: twilio | sandbox (default: twilio when the Twilio secrets are set).
WHATSAPP_PROVIDER=
TWILIO_MESSAGING_SERVICE_SID=MG4d8b6037dc3b183f43b2622307271660
# Optional direct sender (whatsapp:+27…) used only when no Messaging Service SID is set.
TWILIO_WHATSAPP_FROM=
# Public base of this API (no trailing slash); enables Twilio status callbacks at <base>/v1/notifications/twilio/status.
PUBLIC_API_BASE_URL=
# Secrets — in production set with `firebase functions:secrets:set <NAME>`.
# For the emulator, put them in backend/functions/.secret.local (gitignored).
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_WEBHOOK_SECRET=change-me-sandbox-secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional runtime overrides (usually left unset): LOG_LEVEL=debug
