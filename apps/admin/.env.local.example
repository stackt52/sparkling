# Copy to .env.local. All values are public (NEXT_PUBLIC_*) and safe for the browser bundle.

# true = in-memory DemoApi (no backend). false = real REST API + Firebase Auth + Supabase realtime.
NEXT_PUBLIC_DEMO_MODE=true

# Cloud Functions REST API base (without /v1). Emulator shown; prod: https://<region>-sparkling-4e89d.cloudfunctions.net/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/sparkling-4e89d/europe-west1/api

# Supabase project (realtime subscriptions use the Firebase ID token via Third-Party Auth)
NEXT_PUBLIC_SUPABASE_URL=https://uicqczgpiqkczwyssdft.supabase.co
