	     these schemes: the REVERSED_CLIENT_ID from GoogleService-Info.plist and
	     the encoded Firebase iOS app id (GOOGLE_APP_ID with ":" → "-"). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>za.co.sparkling.customer.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.700174326619-jdi2i27vdvl4f9i788hpvkes0f6jg4ir</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>za.co.sparkling.customer.firebase</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-700174326619-ios-77a6daf38eb9861dc5587e</string>
			</array>
		</dict>
	</array>
