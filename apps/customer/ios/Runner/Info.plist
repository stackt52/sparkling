	<string>Sparkling uses the camera to scan the PDF417 barcode on your vehicle licence disc. Decoding happens on your phone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sparkling needs your photo library to attach damage photos to a repair quote request.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
