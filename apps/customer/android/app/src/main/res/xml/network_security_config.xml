<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext HTTP by default. The Firebase Auth emulator and the
  Cloud Functions emulator are plain HTTP on the developer machine, which an
  Android emulator reaches as 10.0.2.2 (and a real device over adb reverse as
  127.0.0.1). Only those loopback/emulator hosts are allowed; everything else
  (Firebase, Supabase, production API) stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
